class CalculatorApp(MDBoxLayout):

    def on_number_press(self, number):
        display_lbl = self.ids.display_label
        if display_lbl.text == "0" or display_lbl.text == "Erro":
            display_lbl.text = str(number)
        else:
            display_lbl.text += str(number)

    def on_operator_press(self, operator):
        display_lbl = self.ids.display_label
        if display_lbl.text != "Erro":
            display_lbl.text += f" {operator} "

    def clear_input(self):
        self.ids.display_label.text = "0"
        self.ids.expression_label.text = ""

    def calculate_result(self):
        expression = self.ids.display_label.text
        if not expression or expression == "Erro":
            return
        try:
            self.ids.expression_label.text = expression + " ="
            result = eval(expression, {"__builtins__": None}, {})
            if isinstance(result, float) and result.is_integer():
                result = int(result)
            self.ids.display_label.text = str(result)
        except Exception:
            self.ids.display_label.text = "Erro"


class CalculatorMDApp(MDApp):

    def build(self):
        self.theme_cls.theme_style = "Dark"
        self.theme_cls.primary_palette = "Purple"
        return CalculatorApp()

    def on_number_press(self, number):
        self.root.on_number_press(number)

    def on_operator_press(self, operator):
        self.root.on_operator_press(operator)

    def clear_input(self):
        self.root.clear_input()

    def calculate_result(self):
        self.root.calculate_result()


