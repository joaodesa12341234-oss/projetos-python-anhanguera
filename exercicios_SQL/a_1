import sqlite3

conn = sqlite3.connect('minhaloja.db')
cursor = conn.cursor()
create_table = """
CREATE TABLE IF NOT EXISTS produtos(
id INTEGER PRIMARY KEY,
nome TEXT NOT NULL,
preco REAL NOT NULL,
estoque INTEGER)
"""

cursor.execute(create_table)
conn.commit()
conn.close()
print('tabela de produtos criada.')



#adicionar produto

