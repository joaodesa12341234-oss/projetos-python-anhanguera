#O sistema deve permitir que o usuário insira as notas dos alunos.
#As notas devem ser armazenadas em uma lista. Cálculo da Média:
#O sistema deve calcular a média das notas inseridas. Determinação da Situação:
#Se a média for maior ou igual a 7, o aluno está aprovado.
#Se a média for menor que 7, o aluno está reprovado. Relatório Final:
#Exibir as notas inseridas, a média e a situação do aluno.


notas = []

for i in range (4):
  nota = float(input(f'digite a {i+1}° nota:  '))
  notas.append(nota)

for i, nota in enumerate(notas):
    print(f"{i+1}ª nota: {nota}")



media = sum(notas) / len(notas)
print (f' sua média foi: {media}')



if media >= 7:
  print('parabens você foi aprovado')
else:
  print('lamentamos, você não foi aprovado')



