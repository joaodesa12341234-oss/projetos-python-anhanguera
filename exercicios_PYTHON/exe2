class pessoa:
  def __init__(self, nome, idade, genero):
    self.nome = nome
    self.idade = int(idade)
    self.genero = genero


  def comprimentar (self):
    return f"olá, meu nome é {self.nome}"
    
  def aniversario(self):
    self.idade += 1

p1 = pessoa('joao', '30', 'masculino',)

